{
  "manifest_version": 3,
  "name": "Optimize Prompt",
  "version": "1.1.1",
  "description": "Instantly optimize your prompts anywhere using Gemini 2.5 Flash.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Optimize Prompt — Open Settings"
  },
  "web_accessible_resources": [
    {
      "resources": ["settings.html", "settings.css", "settings.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "optimize-prompt": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Optimize the current prompt"
    },
    "formalize-message": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Formalize the current message"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
